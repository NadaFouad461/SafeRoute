<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="#1E293B"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Fake Call Setup"
                android:textColor="#1E293B"
                android:textStyle="bold"
                android:textSize="16sp"/>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Escape Discreetly"
            android:textColor="#1E293B"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configure an incoming call to give you a polite reason to leave any situation."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:lineSpacingMultiplier="1.2"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✨ QUICK PRESETS"
            android:textColor="#475569"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.05"/>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMom"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="👩‍👦 Mom"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipStrokeColor="#E2E8F0"
                    app:chipStrokeWidth="1dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipBoss"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="💼 Boss"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipStrokeColor="#E2E8F0"
                    app:chipStrokeWidth="1dp"/>

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipDelivery"
                    style="@style/Widget.MaterialComponents.Chip.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="🍕 Pizza Delivery"
                    app:chipBackgroundColor="#FFFFFF"
                    app:chipStrokeColor="#E2E8F0"
                    app:chipStrokeWidth="1dp"/>
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👤 CALLER IDENTITY"
            android:textColor="#475569"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.05"/>

        <EditText
            android:id="@+id/etCallerName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="6dp"
            android:background="@android:drawable/edit_text"
            android:backgroundTint="#FFFFFF"
            android:hint="Caller Name or Number"
            android:paddingHorizontal="16dp"
            android:textColor="#1E293B"
            android:textSize="14sp"
            android:maxLines="1"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⏱️ TRIGGER DELAY"
            android:textColor="#475569"
            android:textStyle="bold"
            android:textSize="11sp"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.05"/>

        <RadioGroup
            android:id="@+id/rgDelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal">

            <RadioButton
                android:id="@+id/rbDelay5s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5 sec"
                android:textSize="12sp"
                android:checked="true"/>

            <RadioButton
                android:id="@+id/rbDelay10s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="10 sec"
                android:textSize="12sp"/>

            <RadioButton
                android:id="@+id/rbDelay30s"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="30 sec"
                android:textSize="12sp"/>

            <RadioButton
                android:id="@+id/rbDelay1m"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1 min"
                android:textSize="12sp"/>
        </RadioGroup>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🛡️ LIVE PREVIEW"
                    android:textColor="#94A3B8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="32dp"
                    app:cardBackgroundColor="#F1F5F9"
                    app:strokeWidth="0dp">
                    <TextView
                        android:id="@+id/tvPreviewAvatar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📞"
                        android:textSize="24sp"
                        android:layout_gravity="center"/>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/tvPreviewName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mom"
                    android:textColor="#1E293B"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Incoming fake call..."
                    android:textColor="#64748B"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="32dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartSimulation"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="▶  Save &amp; Active Preset"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#74C3EE"
            app:cornerRadius="12dp"
            android:layout_marginBottom="8dp" />

    </LinearLayout>
</ScrollView>