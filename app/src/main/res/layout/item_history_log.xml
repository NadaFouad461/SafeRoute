<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="#E2E8F0">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvLogIcon"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="#F8FAFC"
            android:gravity="center"
            android:text="⚠️"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvLogType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/tvLogIcon"
            android:layout_marginStart="12dp"
            android:text="SOS"
            android:textColor="#1E293B"
            android:textStyle="bold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvLogTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvLogType"
            android:layout_toEndOf="@id/tvLogIcon"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:text="08:24 PM"
            android:textColor="#64748B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLogStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:text="Resolved"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvLogLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tvLogIcon"
            android:layout_marginTop="12dp"
            android:background="#F8FAFC"
            android:padding="8dp"
            android:text="Location Coordinates"
            android:textColor="#334155"
            android:textSize="13sp" />
    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>