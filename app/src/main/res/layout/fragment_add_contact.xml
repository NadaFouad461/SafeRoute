<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@android:drawable/ic_media_previous"
                app:tint="#1A1A1A"
                android:layout_alignParentStart="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add Emergency Contact"
                android:textColor="#1A1A1A"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_centerInParent="true"/>
        </RelativeLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Emergency Connection"
            android:textColor="#1A1A1A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose someone you trust completely. They will be notified immediately during an SOS event."
            android:textColor="#64748B"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.2"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Full Name"
            android:textColor="#1E293B"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="20dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false"
            app:boxStrokeColor="#74C3EE"
            app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
            app:startIconTint="#64748B"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contactNameEt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="e.g. John Doe"
                android:textColorHint="#94A3B8"
                android:inputType="textPersonName"
                android:textColor="#1E293B"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Phone Number"
            android:textColor="#1E293B"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:hintEnabled="false"
            app:boxStrokeColor="#74C3EE"
            app:startIconDrawable="@android:drawable/ic_menu_call"
            app:startIconTint="#64748B"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/contactPhoneEt"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="+1 (555) 000-0000"
                android:textColorHint="#94A3B8"
                android:inputType="phone"
                android:textColor="#1E293B"
                android:textSize="14sp"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relationship"
            android:textColor="#1E293B"
            android:textStyle="bold"
            android:textSize="13sp"
            android:layout_marginTop="16dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/relationshipChipGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">
            <com.google.android.material.chip.Chip
                android:id="@+id/chipFamily"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Family"
                app:chipBackgroundColor="@color/cardview_light_background"
                android:textColor="#1E293B"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipFriend"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Friend"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipPartner"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Partner"/>
            <com.google.android.material.chip.Chip
                android:id="@+id/chipWork"
                style="@style/Widget.MaterialComponents.Chip.Choice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Work"/>
        </com.google.android.material.chip.ChipGroup>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="16dp"
            app:cardBackgroundColor="#E6F4FA"
            app:strokeWidth="0dp"
            app:cardElevation="0dp">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">
                <ImageView
                    android:id="@+id/icShield"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_lock_idle_lock"
                    app:tint="#74C3EE"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_toEndOf="@id/icShield"
                    android:layout_toStartOf="@+id/prioritySwitch"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Priority Contact"
                        android:textColor="#1E293B"
                        android:textStyle="bold"
                        android:textSize="14sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Priority contacts receive SMS alerts even if their phone is in 'Do Not Disturb' mode."
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/prioritySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    app:useMaterialThemeColors="false"
                    app:thumbTint="#74C3EE"
                    app:trackTint="#CBD5E1"/>
            </RelativeLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center_horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">
            <View android:layout_width="24dp" android:layout_height="6dp" android:background="#74C3EE" android:backgroundTint="#74C3EE"/>
            <View android:layout_width="6dp" android:layout_height="6dp" android:background="#E2E8F0" android:layout_marginStart="4dp"/>
            <View android:layout_width="6dp" android:layout_height="6dp" android:background="#E2E8F0" android:layout_marginStart="4dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STEP 1 OF 3" android:textColor="#94A3B8" android:textSize="11sp" android:textStyle="bold" android:layout_marginStart="12dp"/>
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/addContactBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="24dp"
            android:text="+  Add &amp; Save Contact"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="#74C3EE"
            app:cornerRadius="14dp"
            app:elevation="0dp"/>
    </LinearLayout>
</ScrollView>