<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FDFDFD"
    android:padding="28dp"
    android:gravity="center_horizontal">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:layout_marginTop="60dp"
        app:cardCornerRadius="45dp"
        app:cardBackgroundColor="#E6F4FA"
        app:strokeWidth="0dp"
        app:cardElevation="0dp">
        <ImageView
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_dialog_dialer"
            app:tint="#74C3EE" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset Password"
        android:textColor="#1A1A1A"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter your registered email address below, and we'll send you a link to reset your account security."
        android:textColor="#777777"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Registered Email"
        android:textColor="#222222"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginTop="40dp"
        android:layout_marginStart="4dp"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:hintEnabled="false"
        app:boxStrokeColor="#74C3EE"
        app:startIconDrawable="@android:drawable/sym_action_email"
        app:startIconTint="#666666"
        app:boxCornerRadiusTopStart="16dp"
        app:boxCornerRadiusTopEnd="16dp"
        app:boxCornerRadiusBottomStart="16dp"
        app:boxCornerRadiusBottomEnd="16dp"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/emailEt"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="enter your email..."
            android:textColorHint="#AAAAAA"
            android:inputType="textEmailAddress"
            android:textColor="#222222"
            android:textSize="15sp"/>
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/resetBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:text="Send Reset Link  →"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#74C3EE"
        app:cornerRadius="28dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <TextView
        android:id="@+id/backToLoginTv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="←  Back to Login"
        android:textColor="#74C3EE"
        android:textStyle="bold"
        android:textSize="14sp"
        android:layout_marginBottom="20dp"
        android:padding="8dp"/>

</LinearLayout>



