<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:strokeColor="#74C3EE"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/boarding_feature" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#33000000" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Intelligence Meets Safety"
                    android:textColor="#FFFFFF"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Advanced algorithms watching over you 24/7."
                    android:textColor="#EAEAEA"
                    android:textSize="14sp" />
            </LinearLayout>
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Advanced Safeguards"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingMultiplier="1.2"
        android:text="We've added these specialized tools to ensure your safety during your daily commutes and unexpected accidents."
        android:textColor="#666666"
        android:textSize="14sp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="#FAFAFA"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#EAEAEA"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iconFall"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@android:drawable/dialog_holo_light_frame"
                android:padding="6dp"
                android:src="@android:drawable/ic_lock_idle_low_battery"
                app:tint="#74C3EE" />

            <TextView
                android:id="@+id/titleFall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/iconFall"
                android:text="Fall Detection"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@id/titleFall"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/titleFall"
                android:background="#E6F4FA"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="AI POWERED"
                android:textColor="#74C3EE"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/titleFall"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:layout_toEndOf="@id/iconFall"
                android:text="Uses device sensors to detect sudden impact or falls and automatically notifies your emergency contacts if you're unresponsive."
                android:textColor="#777777"
                android:textSize="13sp" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#FAFAFA"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeColor="#EAEAEA"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <ImageView
                android:id="@+id/iconWalk"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="#74C3EE" />

            <TextView
                android:id="@+id/titleWalk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_toEndOf="@id/iconWalk"
                android:text="Safe Walk"
                android:textColor="#222222"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBaseline="@id/titleWalk"
                android:layout_marginStart="8dp"
                android:layout_toEndOf="@id/titleWalk"
                android:background="#F3E5F5"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="LIVE TRACK"
                android:textColor="#9C27B0"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/titleWalk"
                android:layout_marginStart="14dp"
                android:layout_marginTop="4dp"
                android:layout_toEndOf="@id/iconWalk"
                android:text="Walking home alone? Set a timer and share your live path. If you don't reach your destination, an alert is triggered."
                android:textColor="#777777"
                android:textSize="13sp" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:orientation="horizontal">

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Real-time alerts"
            android:textColor="#666666"
            android:textSize="12sp"
            app:chipBackgroundColor="#F5F5F5"
            app:chipIcon="@android:drawable/ic_menu_recent_history"
            app:chipIconTint="#666666"
            app:chipStrokeWidth="0dp" />

        <com.google.android.material.chip.Chip
            style="@style/Widget.MaterialComponents.Chip.Action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Secure data"
            android:textColor="#666666"
            android:textSize="12sp"
            app:chipBackgroundColor="#F5F5F5"
            app:chipIcon="@android:drawable/ic_secure"
            app:chipIconTint="#666666"
            app:chipStrokeWidth="0dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />


</LinearLayout>
