<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.saferoute.ui.auth.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_signUpFragment"
            app:destination="@id/signUpFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgetFragment"
            app:destination="@id/forgetFragment" />
    </fragment>
    <fragment
        android:id="@+id/signUpFragment"
        android:name="com.example.saferoute.ui.auth.SignUpFragment"
        android:label="fragment_sign_up"
        tools:layout="@layout/fragment_sign_up">
        <action
            android:id="@+id/action_signUpFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_signUpFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.saferoute.ui.auth.HomeFragment"
        android:label="fragment_home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_homeFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_homeFragment_to_profileFragment2"
            app:destination="@id/profileFragment2" />
        <action
            android:id="@+id/action_homeFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_homeFragment_to_contactsListFragment"
            app:destination="@id/contactsListFragment" />
        <action
            android:id="@+id/action_homeFragment_to_sosFragment"
            app:destination="@id/sosFragment" />
        <action
            android:id="@+id/action_homeFragment_to_safeWalkFragment"
            app:destination="@id/safeWalkFragment" />
        <action
            android:id="@+id/action_homeFragment_to_fakeCallFragment"
            app:destination="@id/fakeCallFragment" />

    </fragment>
    <fragment
        android:id="@+id/forgetFragment"
        android:name="com.example.saferoute.ui.auth.ForgetFragment"
        android:label="fragment_forget"
        tools:layout="@layout/fragment_forget">
        <action
            android:id="@+id/action_forgetFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/onboardingFragment"
        android:name="com.example.saferoute.ui.start.OnboardingFragment"
        android:label="OnboardingFragment">

        <action
            android:id="@+id/action_onboardingFragment_to_permissionsFragment"
            app:destination="@+id/permissionsFragment"
            app:popUpTo="@+id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/permissionsFragment"
        android:name="com.example.saferoute.ui.start.PermissionsFragment"
        android:label="PermissionsFragment">
        <action
            android:id="@+id/action_permissionsFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
    <fragment
        android:id="@+id/addContactFragment"
        android:name="com.example.saferoute.ui.contact.AddContactFragment"
        android:label="AddContactFragment" />
    <fragment
        android:id="@+id/contactsListFragment"
        android:name="com.example.saferoute.ui.contacts.ContactsListFragment"
        android:label="ContactsListFragment">
        <action
            android:id="@+id/action_contactsListFragment_to_addContactFragment"
            app:destination="@id/addContactFragment" />
        <action
            android:id="@+id/action_contactsListFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>
    <fragment
        android:id="@+id/mapFragment"
        android:name="com.example.saferoute.ui.map.MapFragment"
        android:label="MapFragment">
        <action
            android:id="@+id/action_mapFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_mapFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_mapFragment_to_contactsListFragment"
            app:destination="@id/contactsListFragment" />
        <action
            android:id="@+id/action_mapFragment_to_profileFragment2"
            app:destination="@id/profileFragment2" />

    </fragment>
    <fragment
        android:id="@+id/profileFragment2"
        android:name="com.example.saferoute.ui.history.ProfileFragment"
        android:label="ProfileFragment">
        <action
            android:id="@+id/action_profileFragment2_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_profileFragment2_to_historyFragment"
            app:destination="@id/historyFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.saferoute.ui.history.EditProfileFragment"
        android:label="EditProfileFragment" />
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.saferoute.ui.history.HistoryFragment"
        android:label="HistoryFragment">
        <action
            android:id="@+id/action_historyFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
        <action
            android:id="@+id/action_historyFragment_to_contactsListFragment"
            app:destination="@id/contactsListFragment" />
        <action
            android:id="@+id/action_historyFragment_to_profileFragment2"
            app:destination="@id/profileFragment2" />
        <action
            android:id="@+id/action_historyFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_historyFragment_to_emergencyNotificationFragment2"
            app:destination="@id/emergencyNotificationFragment2" />
    </fragment>
    <fragment
        android:id="@+id/emergencyNotificationFragment"
        android:name="com.example.saferoute.ui.emergency.EmergencyNotificationFragment"
        android:label="EmergencyNotificationFragment">
        <action
            android:id="@+id/action_emergencyNotificationFragment_to_mapFragment"
            app:destination="@id/mapFragment" />
    </fragment>
    <fragment
        android:id="@+id/sosFragment"
        android:name="com.example.saferoute.ui.sos.SosFragment"
        android:label="SosFragment" />
    <fragment
        android:id="@+id/emergencyNotificationFragment2"
        android:name="com.example.saferoute.ui.emergency.EmergencyNotificationFragment"
        android:label="EmergencyNotificationFragment" />
    <fragment
        android:id="@+id/safeWalkFragment"
        android:name="com.example.saferoute.ui.sensors.SafeWalkFragment"
        android:label="fragment_safe_walk"
        tools:layout="@layout/fragment_safe_walk" />
    <fragment
        android:id="@+id/fakeCallFragment"
        android:name="com.example.saferoute.ui.fakeCall.FakeCallFragment"
        android:label="FakeCallFragment" />
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.saferoute.ui.start.SplashFragment"
        android:label="SplashFragment">
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment" />
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>

</navigation>